{
  "name": "pomelo-planning",
  "private": true,
  "version": "0.1.0",
  "description": "Application de planning et de gestion de tickets",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run start:dev --workspace @pomelo/api",
    "dev:web": "npm run dev --workspace @pomelo/web",
    "build": "npm run build --workspace @pomelo/api && npm run build --workspace @pomelo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate --workspace @pomelo/api",
    "db:seed": "npm run prisma:seed --workspace @pomelo/api",
    "db:reset": "npm run prisma:reset --workspace @pomelo/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
